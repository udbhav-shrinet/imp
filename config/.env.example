# Alpaca Paper Trading credentials
APCA_API_BASE_URL=https://paper-api.alpaca.markets
APCA_API_KEY_ID=your_alpaca_key_id_here
APCA_API_SECRET_KEY=your_alpaca_secret_key_here

# Reddit (PRAW) credentials for Team C sentiment scraping
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=trading-system-sentiment-bot/1.0

# News is pulled via public RSS feeds (Yahoo Finance / Google News) --
# no API key required. See tools/reddit_news_scraper.py.

# FRED (St. Louis Fed) API key for macro data (Team B's Economist).
# Free -- register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here
